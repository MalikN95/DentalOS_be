# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dentalos
POSTGRES_PASSWORD=dentalos
POSTGRES_DB=dentalos

# JWT (min 32 chars each, generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-chars
JWT_REFRESH_TTL=30d

# S3 (any S3-compatible storage: AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=dentalos
S3_FORCE_PATH_STYLE=false

# SMTP (used to send patient emails — custom text or configured templates)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=DentalOS

# WhatsApp (Meta Cloud API, https://developers.facebook.com/docs/whatsapp/cloud-api)
# Leave blank to disable — the sender logs a warning and no-ops until set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Firebase Cloud Messaging (web push) — service account credentials from
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Leave blank to disable — the sender logs a warning and no-ops until set.
FIREBASE_PROJECT_ID='dentalos-1e0bb'
FIREBASE_CLIENT_EMAIL='malik.nuriev95@gmail.com'
FIREBASE_PRIVATE_KEY='Y9y6GibfjPAwIGMVDF0VMb82a2KXbrNeYGMdlO2kjGQ'

# Seed — default clinic/admin/staff/patients for local dev
# Run manually via `npm run seed`, or set SEED_ON_START=true to seed on app boot
SEED_ON_START=false
SEED_CLINIC_SLUG=maximum
SEED_CLINIC_NAME=Maximum Dental
SEED_ADMIN_EMAIL=admin@maximum.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_STAFF_PASSWORD=Staff12345
